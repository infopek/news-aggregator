{
  "name": "news-aggregator-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "npm run build && node tests/browser-proof.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "axe-core": "4.10.3",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.11.1",
    "playwright-core": "1.54.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
