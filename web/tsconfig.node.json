{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "eslint.config.js"]
}
